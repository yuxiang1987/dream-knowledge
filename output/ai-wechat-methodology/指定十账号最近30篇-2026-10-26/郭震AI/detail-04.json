999/xhtml&quot;,&quot;data-layout-id&quot;:null}]\"><br  /></span></section><section style=\"text-align: center;margin-left: 16px;margin-right: 16px;\" nodeleaf=\"\"><img data-src=\"https://mmbiz.qpic.cn/sz_mmbiz_png/SxpC5raqFYCNKI577GqcL5M7g9sIRHO5ZibET3gfM1enQwPniaUZTicv3lPM81ursJqywN211PiaA2nnhI36VEt2vwibFOgUIvsuGIW26GHvPCMc/640?wx_fmt=png&amp;from=appmsg\" class=\"rich_pages wxw-img\" data-ratio=\"0.5944444444444444\" data-s=\"300,640\" data-type=\"png\" data-w=\"1080\" type=\"block\" data-imgfileid=\"100041820\" data-aistatus=\"1\"  /></section><section style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\" data-pm-slice=\"1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null}]\"><br  /></span></section><section style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\" data-pm-slice=\"1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null}]\"><span textstyle=\"\" style=\"font-size: 16px;letter-spacing: 2px;\">部分回答：</span></span></section><section style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\" data-pm-slice=\"1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null}]\"><br  /></span></section><section style=\"text-align: center;margin-left: 16px;margin-right: 16px;\" nodeleaf=\"\"><img data-src=\"https://mmbiz.qpic.cn/mmbiz_png/SxpC5raqFYC1jlEStaobmPbJU3zZyriaeM0FfFUCdjJdXO41eG5p1EWXDmngVicOyqwtEmuOlNa1GeKtuDU9PzHPGVoibiciaFLkkGLB73h6UW14/640?wx_fmt=png&amp;from=appmsg\" class=\"rich_pages wxw-img\" data-ratio=\"0.5833333333333334\" data-s=\"300,640\" data-type=\"png\" data-w=\"1080\" type=\"block\" data-imgfileid=\"100041821\" data-aistatus=\"1\"  /></section><section style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\" data-pm-slice=\"1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null}]\"><br  /></span></section><section style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\" data-pm-slice=\"1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null}]\"><span textstyle=\"\" style=\"font-size: 17px;letter-spacing: 2px;color: rgb(0, 82, 255);font-weight: bold;\">最后总结一下</span></span></section><section style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\" data-pm-slice=\"1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null}]\"><br  /></span></section><p dir=\"ltr\" data-pm-slice=\"0 0 []\" style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 16px;letter-spacing: 2px;\">电脑里的文件越积越多，通用智能体很难按问题的意思从几千个文件里把答案找全，NotebookLM 就算开通 Pro，一个知识库也只能放 300 个文件。</span></span></p><p dir=\"ltr\" data-pm-slice=\"0 0 []\" style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\"><br  /></span></p><p dir=\"ltr\" style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 16px;letter-spacing: 2px;\">DeepLocals 一张卡片就是一个知识库，能装几千个文件，支持 55 种格式，扫描件里的公式和表格也能基本保留；问答时图文回复，每句话都能点开引用查看证据，还有问答地图追溯每一次回答引用了哪些资料。</span></span></p><p dir=\"ltr\" style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\"><br  /></span></p><p dir=\"ltr\" style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\"><span textstyle=\"\" style=\"font-size: 16px;letter-spacing: 2px;\">如果你感兴趣，搜索&nbsp;DeepLocals，使用它帮你检索总结电脑上的文件。</span></span></p><p dir=\"ltr\" style=\"margin-left: 16px;margin-right: 16px;\"><span leaf=\"\"><br  /></span></p><p dir=\"ltr\" style=\"margin-left: 16px;margin-right: 16px;\"><span data-pm-slice=\"0 0 []\"><span leaf=\"\" style=\"color: rgba(0, 0, 0, 0.9);font-size: 17px;font-family: mp-quote, &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;line-height: 1.6;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\"><span textstyle=\"\" style=\"font-size: 16px;letter-spacing: 2px;\">全文约1869字，26张图。如果你觉得这篇实测有用，老规矩，求个三连：点赞、转发和在看；如果可以，再帮我点一个⭐️。感谢阅读，我是郭震，我们下篇再见。</span></span></span></p></section><p style=\"display: none;\"><mp-style-type data-value=\"3\"></mp-style-type></p>",
    "content_text": "你好，我是郭震！ 我经常会遇到这样的痛点，就是电脑里，有各种文件散落在不同的文件夹，想找一句话、核对一个数据，太费劲了，最后可能找半天都无功而返。 相信你也有遇到过。今天这篇文章我们看看如何解决 1 通用智能体 Codex，Claude code，豆包，Workbuddy，这些智能体强还是很强，但很难从几千个文件根据问题意思找全答案。 如下图所示，强入Claude code ，哪怕配备 Opus 5.5，直接问它能不能做到： 它的答案非常诚实：不能。 不用关键词、只靠问题的大意，2 分钟连其中一小部分都读不完，更谈不上准确找到答案。 于是RAG知识库诞生了，如比较知名的：腾讯IMA，谷歌NotebookLLM，很多人都在每天使用。 我也经常在用，但是我发现NotebookLLM一个知识库，即便是Pro也只能放入300个文件： 一个知识库只能放最多300个文件，这个量级真的不够用，咱们不说企业，就是个人，使用电脑1年多，随随便便就超过三百。 更糟的是，我在使用NotebookLLM时，PDF里的公式和表格几乎导入后排版全部乱掉： 在此不再一一列举，如何解决这样的问题呢？ 于是我们开发了DeepLocals知识库。 它的出现，就是专门为了解决以上这些问题，不仅一个卡片能支持几千个文件，而且还能跨知识库语义检索： 配备本地大模型Qwen3.8:27B，直接对上千个本地电脑文件做知识问答，随便问，还不限次： 而且导入的文件，即便难度很大的扫描件，公式、图片和排版也能基本保留，如下图所示为导入到DeepLocals后的文件显示： 2 DeepLocals和LLM Wiki区别 LLM Wiki 是前段时间 Karpathy 提出的一个思路，让大模型把资料整理成一份 Wiki 来问答。 概念很巧，几十份文档，玩一下，挺好。 但是资料一多、格式一杂就难以支撑。DeepLocals 从一开始就是按真实工作场景设计的，一个知识库能胜任几千个文件，知识问答精度也有保证，如下从一千多个文件做知识问答，即便带有思考+规划+多轮检索： 从思考到完整回复完成，只有48秒： 以上GIF动画，未经任何加速处理， 完整保证1:1速度还原，就是让大家看到真实的回复速度。 一句话：LLM Wiki只是一个玩具，几十个文件导入回答没问题；但是再多，还得使用IMA，NotebookLLM，DeepLocals这样的RAG知识库。 3 DeepLocals的使用教程 DeepLocals第一个特色：支持本地电脑海量文件的学习，如下我的电脑6839个文件： 16个知识库，每个卡片就是一个知识库。 新建卡片，立即拥有1个知识库，点击进入就会看到下面界面： DeepLocals第二个特色：一共支持多达55种文件类型，而NotebookLLM支持43种： 下一版我们会支持视频处理，格式种类将到达66种： 支持按照文件，文件夹，Obsidian笔记，智能学习四种模式。 导入你的资料后，就可以利用你的资料起来，做知识问答，如下图所示，支持图文回复： 图文回复演示2： 点击句子后面的引用，立即看到对应的证据，最大程度降低幻觉： 同时看到每次问答与引用文献的地图： 如下为最近5次问答的资料引用地图，点击节点可以跳转到对应问答和参考文献资料： 这是DeepLocals的第三大特色：图文回复+问答地图。 DeepLocals现在是RAG原生智能体+Skills，这是它的第四大特色，如下图所示，支持跨文件格式检索+直接导出多种文件格式： 导出Word文档： 除此以外，还有实用的十多个Skill，提升办公效率： 第五个特色支持本地大模型，使用安全，且免费： 且支持三种本地大模型主流配置模式： 你可以在本地不限次、一直对你的资料做知识问答，如下为Qwen3.8:27B思考过程： 部分回答： 最后总结一下 电脑里的文件越积越多，通用智能体很难按问题的意思从几千个文件里把答案找全，NotebookLM 就算开通 Pro，一个知识库也只能放 300 个文件。 DeepLocals 一张卡片就是一个知识库，能装几千个文件，支持 55 种格式，扫描件里的公式和表格也能基本保留；问答时图文回复，每句话都能点开引用查看证据，还有问答地图追溯每一次回答引用了哪些资料。 如果你感兴趣，搜索 DeepLocals，使用它帮你检索总结电脑上的文件。 全文约1869字，26张图。如果你觉得这篇实测有用，老规矩，求个三连：点赞、转发和在看；如果可以，再帮我点一个⭐️。感谢阅读，我是郭震，我们下篇再见。",
